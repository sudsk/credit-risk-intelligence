# Copy to deploy/deploy.env (git-ignored), fill in, then:
#   source deploy/deploy.env && bash deploy/deploy.sh

# Required
export PROJECT_ID=your-gcp-project-id
export NETWORK=your-existing-vpc-network
export SUBNET=your-existing-subnet            # must be in REGION
export IAP_MEMBERS=domain:example.com         # comma-separated: domain:, group:, user:

# Optional (defaults shown)
# export REGION=europe-west2
# export GEMINI_MODEL=gemini-3.7-flash
# export GEMINI_LOCATION=europe-west2         # or "global" if the model isn't regional
# export REPO=credit-risk                     # Artifact Registry repo name
# export DOMAIN=                              # empty = <lb-ip>.nip.io
